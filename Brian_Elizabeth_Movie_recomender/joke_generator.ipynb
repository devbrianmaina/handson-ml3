import requests
import json
from IPython.display import display, HTML

def fetch_random_joke():
    """
    Fetches a random joke from JokeAPI
    Returns the joke data as a dictionary
    """
    try:
        url = "https://v2.jokeapi.dev/joke/Any"
        response = requests.get(url)
        response.raise_for_status()
        return response.json()
    except requests.exceptions.RequestException as e:
        return {"error": f"Failed to fetch joke: {str(e)}"}

def display_joke(joke_data):
    """
    Displays the joke in a formatted way
    """
    if "error" in joke_data:
        print(f"❌ {joke_data['error']}")
        return
    
    if joke_data.get("type") == "single":
        print(f"😂 {joke_data['joke']}")
    elif joke_data.get("type") == "twopart":
        print(f"😂 {joke_data['setup']}")
        print(f"   {joke_data['delivery']}")
    
    print(f"\n📊 Category: {joke_data.get('category', 'Unknown')}")
    print(f"🔖 ID: {joke_data.get('id', 'N/A')}")

# Fetch and display a joke
print("🎭 Random Joke Generator")
print("=" * 50)
joke = fetch_random_joke()
display_joke(joke)
